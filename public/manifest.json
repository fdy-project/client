{
  "manifest_version": 3,
  "name": "FDY Write",
  "version": "1.0.0",
  "description": "Secure, encrypted workspace popup",
  "action": {
    "default_popup": "index.html",
    "default_width": 400,
    "default_height": 600
  },
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://api.fdy.co.kr/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
