# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js & build
/.next/
/out/
.plasmo/
build/
dist/

# production build
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables (CRITICAL: NEVER COMMIT THESE!)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# security & secrets
*.pem
memo.md

# IDE / Editors
.vscode/
.idea/
*.swp
*.swo

# Misc
.DS_Store
Thumbs.db
extension.zip

# typescript
*.tsbuildinfo
next-env.d.ts
